!frontend/
frontend/*
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
**/__pycache__/**
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/model-settings.json
**/credentials.json
**/*.pem
**/*.p12
**/*.pfx
