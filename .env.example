OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BRIEF_MODEL=
# 可选：主模型在开始流式输出前请求失败时，使用同一 API 服务上的备用模型
# OPENAI_FALLBACK_MODEL=
# 可选：OpenAI 兼容服务的 API 根地址（通常包含 /v1）
# OPENAI_BASE_URL=
TRACEFORGE_DATA_DIR=.traceforge-data
# 可选：网页模型配置的独立目录；默认使用用户的系统配置目录
# TRACEFORGE_CONFIG_DIR=
TRACEFORGE_CONTEXT_WINDOW=128000
TRACEFORGE_DOCKER_IMAGE=traceforge-runner:local
TRACEFORGE_APPROVAL_TIMEOUT=600
TRACEFORGE_COMMAND_TIMEOUT=120
# 0 表示不限制；达到预算会停止本轮并询问是否继续
TRACEFORGE_MAX_RUN_TOKENS=0
# 设置美元预算前请先填写下面的模型单价
TRACEFORGE_MAX_RUN_COST_USD=0
# 可选：按实际 API 用量估算美元费用；0 表示不显示费用估算
TRACEFORGE_INPUT_USD_PER_1M=0
TRACEFORGE_OUTPUT_USD_PER_1M=0
# Trusted local Python hooks, comma-separated module:attribute values
TRACEFORGE_HOOKS=
# Trusted local Python functions registering sandbox command tools
TRACEFORGE_TOOL_PLUGINS=
